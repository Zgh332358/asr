# StepFun cloud ASR; copy to .env and keep that file private.
# Local API authentication belongs at your API gateway. Do not expose it openly.
HOST=127.0.0.1
PORT=8080
CORS_ORIGINS=

# Server-side provider configuration. User supplies the key later.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.stepfun.com/v1
ASR_MODEL=stepaudio-3-chat-preview
REQUEST_TIMEOUT_SECONDS=120

# Local admission limits; provider limits may be stricter. Start with short clips.
MAX_UPLOAD_BYTES=524288000
MAX_AUDIO_DURATION=600
# Metadata hint only; StepFun chat does not return detected-language metadata.
DEFAULT_LANGUAGE=zh
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10
LOG_LEVEL=info
LOG_FORMAT=json
TEMP_DIR=/tmp/whisper_api

# Empty = stateless. For corpus mode apply 001_init.sql then 002_stepfun_engine.sql.
# Existing databases only need 002. Keep database credentials private.
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_POOL_OVERFLOW=10
STORAGE_PATH=/data/asr_storage
TASK_POLL_INTERVAL=5
TASK_MAX_RETRIES=3
MAX_CONCURRENT_TASKS=2
MAIN_BACKEND_CALLBACK_URL=
CALLBACK_MAX_RETRIES=5
CALLBACK_RETRY_BASE_DELAY=1.0
HTTP_PROXY=
HTTPS_PROXY=
